# ============================================================
# 环境变量模板 — 复制为 .env 后按需修改（.env 不入库）
#   cp env.example .env        （或直接运行 ./start_dev.sh 自动生成）
# 本地开发默认走 SQLite，无需修改即可运行；
# Docker 部署时 docker-compose 会自动注入 PostgreSQL 连接串。
# ============================================================

# 数据库连接（SQLAlchemy URL）。
# 本地开发默认：SQLite 文件，位于项目根目录 app_data.db
# PostgreSQL 示例：
#   DATABASE_URL=postgresql+psycopg2://pptmaker:密码@127.0.0.1:5432/pptmaker
DATABASE_URL=sqlite:///app_data.db

# PostgreSQL 密码（docker-compose 用于初始化 postgres 容器，
# 并拼接 compose 内部的 DATABASE_URL；本地 SQLite 开发无需理会）
POSTGRES_PASSWORD=change-me-in-production

# Redis 连接地址（预留：当前版本会话与后台任务均在进程内实现，
# 尚未使用 Redis；compose 中已起 redis 容器供后续接入任务队列）
REDIS_URL=redis://redis:6379/0

# 共享 API Key 的数据库加密密钥（Fernet key，44 字符 base64）。
# 留空时自动生成并持久化到 data/encryption.key（Docker 中随 web_data 卷持久化）。
# 生产环境建议显式配置并妥善备份——密钥丢失将导致已保存的共享 Key 无法解密。
# 生成方式：
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# ENCRYPTION_KEY=
